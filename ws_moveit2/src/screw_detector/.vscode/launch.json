    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Write to file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/screw_detector/screw_detector.py",
            "console": "integratedTerminal",
            "args": [
                "--ros-args",
                "-p", "write_to_file:=true",
                "-p", "output_dir:=/home/remanpilot/ATP25_26_Gruppe6_Entschraubung/detector_payload"
            ]
        },
        {
            "name": "Python: File",
            "type": "python",
            "request": "launch",
            "program": "my_node.py"
        },
    ]
}